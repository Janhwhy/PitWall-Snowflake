# Required to run the FastAPI backend (api/main.py) — powers all agent LLM calls
GROQ_API_KEY=your_groq_api_key_here

# Only needed for the offline ingest/ scripts, not the deployed API:
# Anthropic API Key (unused by current ingest scripts, reserved for future use)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OpenAI API Key for Whisper audio transcription (ingest/transcribe_radio.py)
OPENAI_API_KEY=your_openai_api_key_here

# Snowflake connection (key-pair auth, no password) — see secrets/README.md for key generation
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_username
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PITWALL
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake_rsa_key.p8
